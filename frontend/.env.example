# ─── Frontend-only ──────────────────────────────────────────
# Only VITE_-prefixed variables are exposed to the client bundle.
# All backend secrets (Mongo, JWT, OAuth, Cloudinary, WhatsApp, Sentry)
# live in backend/.env — never duplicate them here.

# Set to "false" to temporarily hide the "Continue with Google" CTA on
# the login page. Backend must also set ENABLE_GOOGLE_AUTH=false so the
# OAuth routes return 503. Defaults to enabled.
VITE_ENABLE_GOOGLE_AUTH=true

# Base URL for local development and explicit direct-API test fixtures. Leave
# UNSET for the Vercel web deployment: frontend/vercel.json proxies /api to the
# backend so refresh cookies remain first-party.
# VITE_API_URL=

# Production web builds ignore a cross-origin VITE_API_URL by default. Set this
# only for a controlled fixture or a deployment whose cookie behavior has been
# separately verified. It is not appropriate for the Vercel + Render setup.
# VITE_DIRECT_CROSS_ORIGIN_API=false
